# Variables de entorno para Vercel
# NO subir este archivo a GitHub - está en .gitignore

# ========================================
# FRONTEND (Público - seguro exponer)
# ========================================

# URL de tu proyecto Supabase
# Ejemplo: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://rsujclfftqfbudbirsxj.supabase.co

# Clave pública anon de Supabase (segura para frontend)
# Esta clave tiene restricciones de RLS (Row Level Security)
# Ejemplo: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJzdWpjbGZmdHFmYnVkYmlyc3hqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzAwNDc2ODgsImV4cCI6MjA4NTYyMzY4OH0.hgHvdxKbkB-u_GKlMZvh3-a1Vc42a0V0WwmHmJE9yCg


# ========================================
# BACKEND (Privado - NO exponer)
# ========================================

# URL de Supabase (igual que la pública)
SUPABASE_URL=tu_supabase_url_aqui

# Service Role Key (PRIVADA - solo para backend)
# ⚠️ NUNCA usar esta clave en el frontend
# Esta clave ignora RLS y tiene acceso completo
SUPABASE_KEY=tu_supabase_service_role_key_aqui

# Secreto para firmar JWT tokens
# Genera uno aleatorio con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=tu_secreto_jwt_aleatorio_aqui


# ========================================
# CÓMO OBTENER LAS CLAVES DE SUPABASE
# ========================================
#
# 1. Ve a https://supabase.com/dashboard
# 2. Selecciona tu proyecto
# 3. Settings → API
# 4. Copia:
#    - Project URL → SUPABASE_URL / NEXT_PUBLIC_SUPABASE_URL
#    - anon public → NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - service_role → SUPABASE_KEY (backend only)


# ========================================
# CONFIGURACIÓN EN VERCEL
# ========================================
#
# Ejecuta estos comandos:
#
# vercel env add NEXT_PUBLIC_SUPABASE_URL
# vercel env add NEXT_PUBLIC_SUPABASE_ANON_KEY
# vercel env add SUPABASE_URL
# vercel env add SUPABASE_KEY
# vercel env add JWT_SECRET
#
# O configura desde el Dashboard:
# https://vercel.com/dashboard → tu-proyecto → Settings → Environment Variables


# ========================================
# DESARROLLO LOCAL
# ========================================
#
# Para frontend (consola del navegador):
#
# localStorage.setItem('NEXT_PUBLIC_SUPABASE_URL', 'https://tu-proyecto.supabase.co')
# localStorage.setItem('NEXT_PUBLIC_SUPABASE_ANON_KEY', 'eyJ...')
# location.reload()
#
# Para backend serverless functions:
# Crea un archivo .env en la raíz con estas variables
