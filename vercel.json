{
  "buildCommand": "echo 'Build complete'",
  "devCommand": "vercel dev",
  "outputDirectory": ".",
  "framework": "vanilla",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "env": {
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_KEY": "@supabase_key",
    "JWT_SECRET": "@jwt_secret"
  },
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
